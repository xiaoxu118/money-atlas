---
import type { CollectionEntry } from 'astro:content';
import SiteLayout from './SiteLayout.astro';
import { topicHref } from '../data/topic-links';
interface Props {
  topic: CollectionEntry<'topics'>;
  topics: CollectionEntry<'topics'>[];
}
const { topic, topics } = Astro.props;
const data = topic.data;
const related = topics.filter(
  (t) =>
    t.data.id !== data.id &&
    t.data.concepts.some((c) => data.concepts.includes(c)),
);
---

<SiteLayout title={data.title} description={data.summary}>
  <div class="topic-shell">
    <aside class="topic-toc">
      <a href="/knowledge/macro/">← 宏观知识</a>
      <nav aria-label="相关主题导航">
        {topics.map((t) => (
          <a
            href={topicHref(t.data.slug)}
            aria-current={t.data.id === data.id ? 'page' : undefined}
          >
            {t.data.title}
          </a>
        ))}
      </nav>
    </aside>
    <article class="topic">
      <header class="topic-heading">
        <span class="eyebrow">MACRO / EXPLAINED</span>
        <h1>{data.title}</h1>
        <p class="lead">{data.summary}</p>
        <p class="meta">更新于 {data.updatedAt.toISOString().slice(0, 10)}</p>
      </header>
      <div class="prose">
        <slot />
      </div>
      <section class="sources">
        <h2>资料来源与延伸阅读</h2>
        <ul>
          {data.sources.map((source) => (
            <li>
              <a href={source.url} target="_blank" rel="noopener noreferrer">
                {source.title} ↗
              </a>
            </li>
          ))}
        </ul>
      </section>
      {related.length > 0 && (
        <section class="related-topics">
          <h2>相关主题</h2>
          <div class="controls">
            {related.map((t) => (
              <a class="text-link" href={topicHref(t.data.slug)}>
                {t.data.title} →
              </a>
            ))}
          </div>
        </section>
      )}
    </article>
  </div>
</SiteLayout>
