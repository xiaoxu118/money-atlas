---
import type { CollectionEntry } from 'astro:content';
import SiteLayout from './SiteLayout.astro';
import ContentNav from '../components/navigation/ContentNav.astro';
import ConceptNotes from '../components/navigation/ConceptNotes.astro';
import { modules, topicGroups, topicRelations } from '../data/content-map';
import { topicHref, readingEntryHref } from '../data/topic-links';
interface Props {
  topic: CollectionEntry<'topics'>;
  topics: CollectionEntry<'topics'>[];
}
const { topic, topics } = Astro.props;
const data = topic.data;
const module = modules.find((m) => m.id === data.module)!;
const group = topicGroups.find((g) => g.id === data.group)!;
const explicit = topicRelations[data.id] ?? [];
const rank = (topic: CollectionEntry<'topics'>) =>
  (explicit.includes(topic.data.id) ? 10 : 0) +
  (topic.data.module !== data.module ? 2 : 0) +
  (topic.data.group === data.group ? 1 : 0);
const related = topics
  .filter(
    (t) =>
      t.data.id !== data.id &&
      (explicit.includes(t.data.id) ||
        t.data.concepts.some((c) => data.concepts.includes(c))),
  )
  .sort((a, b) => rank(b) - rank(a))
  .slice(0, 6);
---

<SiteLayout title={data.title} description={data.summary} wide>
  <div class="reading-layout">
    <aside class="reading-sidebar">
      <h2>内容目录</h2>
      <ContentNav topics={topics} active={topic} />
    </aside>
    <div class="reading-main">
      <details class="mobile-content-tree">
        <summary>目录 · {group.title}</summary>
        <ContentNav topics={topics} active={topic} />
      </details>
      <article class="topic topic-detail">
        <header class="topic-heading">
          <nav class="breadcrumbs" aria-label="当前位置">
            <a href="/">首页</a>
            <span aria-hidden="true">/</span>
            <a href={readingEntryHref(data.module)}>{module.title}</a>
            <span aria-hidden="true">/</span>
            <a href={readingEntryHref(data.module, group.id)}>{group.title}</a>
          </nav>
          <h1>{data.title}</h1>
          <p class="lead">{data.summary}</p>
        </header>
        <ConceptNotes related={data.concepts} />
        <div class="prose">
          <slot />
        </div>
        {related.length > 0 && (
          <section class="related-topics">
            <h2>关联阅读</h2>
            <ul>
              {related.map((t) => (
                <li>
                  <a href={topicHref(t.data)}>{t.data.title} →</a>
                  <span class="meta">
                    {' '}
                    {modules.find((m) => m.id === t.data.module)!.title}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        )}
        <section class="sources">
          <h2>资料来源与延伸阅读</h2>
          <ul>
            {data.sources.map((source) => (
              <li>
                <a href={source.url} target="_blank" rel="noopener noreferrer">
                  {source.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      </article>
    </div>
  </div>
</SiteLayout>

<script>
  // Keep table semantics and column comparisons intact on narrow screens.
  document
    .querySelectorAll<HTMLTableElement>('.prose table')
    .forEach((table) => {
      if (table.parentElement?.classList.contains('table-scroll')) return;
      const container = document.createElement('div');
      container.className = 'table-scroll';
      container.tabIndex = 0;
      container.setAttribute('role', 'region');
      container.setAttribute(
        'aria-label',
        `${table.caption?.textContent?.trim() || '数据表格'}，窄屏可左右滚动`,
      );
      table.before(container);
      container.append(table);
    });
</script>
