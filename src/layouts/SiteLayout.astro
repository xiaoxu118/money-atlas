---
import '../styles/global.css';
import '../styles/editorial.css';
import PageEditor from '../components/PageEditor.astro';
interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}
const {
  title,
  wide = false,
  description = '把货币、利率与通胀画成图，用图解和具体例子讲清经济运行。',
} = Astro.props;
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · 钱图</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
  </head>
  <body>
    <a class="skip" href="#main">
      跳到正文
    </a>
    <header class="site-header">
      <a class="brand" href="/">
        <span class="brand-mark">
          钱图<span aria-hidden="true">.</span>
        </span>
        <span class="brand-en" lang="en">
          Money Atlas
        </span>
      </a>
      <nav aria-label="主导航">
        <a
          href="/knowledge/overview/"
          aria-current={
            Astro.url.pathname === '/knowledge/overview/' ? 'page' : undefined
          }
        >
          内容目录
        </a>
        <a
          href="/knowledge/macro/money/"
          aria-current={
            Astro.url.pathname.startsWith('/knowledge/macro/')
              ? 'page'
              : undefined
          }
        >
          金融原理
        </a>
        <a
          href="/knowledge/investing/invest-vs-speculation/"
          aria-current={
            Astro.url.pathname.startsWith('/knowledge/investing/')
              ? 'page'
              : undefined
          }
        >
          投资
        </a>
        <a
          href={
            wide && Astro.url.pathname !== '/knowledge/overview/'
              ? '#concepts'
              : '/knowledge/macro/money/#concepts'
          }
          aria-current={
            Astro.url.pathname.startsWith('/concepts/') ? 'page' : undefined
          }
        >
          概念速查
        </a>
      </nav>
    </header>
    <main id="main" class:list={{ 'reading-container': wide }}>
      <slot />
    </main>
    <footer class="site-footer">
      <span>钱图 / MONEY ATLAS</span>
      <span>金融机制与投资分析 · 图中数字均为简化情景</span>
    </footer>
    <PageEditor />
  </body>
</html>
