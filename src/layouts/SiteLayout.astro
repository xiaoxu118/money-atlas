---
import '../styles/global.css';
interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}
const {
  title,
  wide = false,
  description = '把货币、利率与通胀画成图，用图解和具体例子讲清经济运行。',
} = Astro.props;
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · 钱图</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
  </head>
  <body>
    <a class="skip" href="#main">
      跳到正文
    </a>
    <header class="site-header">
      <a class="brand" href="/">
        <span>◈ 钱图</span>
        <span class="brand-en" lang="en">
          Money Atlas
        </span>
      </a>
      <nav aria-label="主导航">
        <a
          href="/knowledge/"
          aria-current={
            Astro.url.pathname === '/knowledge/' ? 'page' : undefined
          }
        >
          知识图解
        </a>
        <a
          href="/knowledge/macro/"
          aria-current={
            Astro.url.pathname.startsWith('/knowledge/macro/')
              ? 'page'
              : undefined
          }
        >
          金融原理
        </a>
        <a
          href="/knowledge/investing/"
          aria-current={
            Astro.url.pathname.startsWith('/knowledge/investing/')
              ? 'page'
              : undefined
          }
        >
          投资
        </a>
        <a
          href="/concepts/"
          aria-current={
            Astro.url.pathname.startsWith('/concepts/') ? 'page' : undefined
          }
        >
          概念索引
        </a>
      </nav>
    </header>
    <main id="main" class:list={{ 'reading-container': wide }}>
      <slot />
    </main>
    <footer class="site-footer">
      <span>钱图 Money Atlas / 先理解，再做判断</span>
      <span>全部数字为简化示例</span>
    </footer>
  </body>
</html>
