---
const target = '/knowledge/';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>查看知识图解</title>
  </head>
  <body>
    <a href={target}>查看知识图解</a>
    <script is:inline define:vars={{ target }}>
      location.replace(target);
    </script>
  </body>
</html>
