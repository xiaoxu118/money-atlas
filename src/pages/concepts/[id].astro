---
import { concepts } from '../../data/concepts';
import { topicPlan } from '../../data/content-map';
import { topicHref } from '../../data/topic-links';
export function getStaticPaths() {
  return concepts.map((concept) => ({
    params: { id: concept.id },
    props: { concept },
  }));
}
const { concept } = Astro.props;
const topic = topicPlan.find((topic) => concept.topics.includes(topic.id))!;
const target = topicHref(topic) + '#concept-' + concept.id;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{concept.title} · 正文概念解释</title>
  </head>
  <body>
    <a href={target}>在正文中查看{concept.title}</a>
    <script is:inline define:vars={{ target }}>
      location.replace(target);
    </script>
  </body>
</html>
