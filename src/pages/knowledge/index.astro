---
const target = '/knowledge/overview/';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>内容目录</title>
  </head>
  <body>
    <a href={target}>进入内容目录</a>
    <script is:inline define:vars={{ target }}>
      location.replace(target);
    </script>
  </body>
</html>
